{
  "name": "pomodoro-timer",
  "version": "2.0.0",
  "description": "A calm, bilingual focus workspace with return tickets, a distraction inbox, and a session journal.",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "lucide-react": "^1.43.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.13"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "^5.3.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
